{
    "name": "nks-hub/nette-markdown",
    "description": "Nette DI extension wrapping league/commonmark with Latte filter support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "NKS Hub"
        }
    ],
    "require": {
        "php": "^8.2",
        "league/commonmark": "^2.8",
        "nette/di": "^3.1",
        "latte/latte": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "nette/bootstrap": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "NksHub\\Markdown\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NksHub\\Markdown\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
